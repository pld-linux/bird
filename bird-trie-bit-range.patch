From 896f96ac281978a474a20d3cbb876c04fcf3df83 Mon Sep 17 00:00:00 2001
From: David Seddon <dave.seddon.ca@gmail.com>
Date: Thu, 5 Nov 2026 02:55:20 +0100
Subject: [PATCH] Filter: Fix out-of-range bit access in trie

ip4_getbits()/ip6_getbits() with n == 0 shifted a u32 by 32, and
ip6_getbits() read a.addr[4] when pos == 128. trie_local_mask6() calls
them with a zero step whenever the prefix length equals the node length,
so this runs for every IPv6 route whose prefix length is a multiple of
32, e.g. from rt_notify_hostcache() via trie_match_net(). The result was
masked to 0, so behaviour was unaffected. Return 0 for n == 0.

trie_node_format() tested accept bit nlen + i - 1 for i up to
TRIE_STEP - 1, i.e. bits 32..34 of an IPv4 /32 node and 128..130 of an
IPv6 /128 node, past the end of the address. Stop at the address length.

Similar patch was also posted by Sebastien Wenske <sebastien@wenske.fr>.

Reported-By: Sergey L <sergeylobanov87nn@gmail.com> and others
Target: patch
Issue: #297
---
 filter/trie.c | 3 ++-
 lib/ip.h      | 5 +++--
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/filter/trie.c b/filter/trie.c
index 2ffdf7b..84ad719 100644
--- a/filter/trie.c
+++ b/filter/trie.c
@@ -1082,9 +1082,10 @@ trie_node_format(const struct f_trie_node *n, buffer *buf, int v4)
   }
 
   int nlen = v4 ? n->v4.plen : n->v6.plen;
+  int max_len = v4 ? IP4_MAX_PREFIX_LENGTH : IP6_MAX_PREFIX_LENGTH;
   uint local = v4 ? n->v4.local : n->v6.local;
 
-  for (int i = (nlen ? 0 : 1); i < TRIE_STEP; i++)
+  for (int i = (nlen ? 0 : 1); (i < TRIE_STEP) && (nlen + i <= max_len); i++)
     if (GET_ACCEPT_BIT(n, v4, nlen + i - 1))
       local &= ~trie_level_mask(1, i);
 
diff --git a/lib/ip.h b/lib/ip.h
index 5fbfd68..cd81a80 100644
--- a/lib/ip.h
+++ b/lib/ip.h
@@ -327,14 +327,15 @@ static inline int ip6_prefix_equal(ip6_addr a, ip6_addr b, uint n)
 static inline u32 ip4_getbit(ip4_addr a, uint pos)
 { return (_I(a) >> (31 - pos)) & 1; }
 
+/* Read n < 32 bits within one word; n == 0 returns 0, including at the address end */
 static inline u32 ip4_getbits(ip4_addr a, uint pos, uint n)
-{ return (_I(a) >> ((32 - n) - pos)) & ((1u << n) - 1); }
+{ return n ? (_I(a) >> ((32 - n) - pos)) & ((1u << n) - 1) : 0; }
 
 static inline u32 ip6_getbit(ip6_addr a, uint pos)
 { return (a.addr[pos / 32] >> (31 - (pos % 32))) & 0x1; }
 
 static inline u32 ip6_getbits(ip6_addr a, uint pos, uint n)
-{ return (a.addr[pos / 32] >> ((32 - n) - (pos % 32))) & ((1u << n) - 1); }
+{ return n ? (a.addr[pos / 32] >> ((32 - n) - (pos % 32))) & ((1u << n) - 1) : 0; }
 
 static inline u32 ip4_setbit(ip4_addr *a, uint pos)
 { return _I(*a) |= (0x80000000 >> pos); }
